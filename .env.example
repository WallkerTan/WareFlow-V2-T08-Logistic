# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Eureka & Config Server
EUREKA_HOST=localhost
EUREKA_PORT=8761
CONFIG_SERVER_HOST=localhost
CONFIG_SERVER_PORT=8888

# Service Ports
GATEWAY_PORT=8080
CORE_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
FINANCE_SERVICE_PORT=8083
DELIVERY_SERVICE_PORT=8084


# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (opt in after SMTP is configured)
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@wareflow.local
SMTP_AUTH=true
SMTP_STARTTLS=true

# Server-to-server authentication; use a long random secret
INTERNAL_API_KEY=
FINANCE_SERVICE_URL=http://localhost:8083
CORE_SERVICE_URL=http://localhost:8081

INVENTORY_SERVICE_URL=http://localhost:8082
ADMIN_EMAIL=admin@wareflow.com
ADMIN_PASSWORD=admin123
